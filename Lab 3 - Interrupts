#include <avr/io.h>
#include <avr/interrupt.h>

//** GLOBAL VARIABLES **/
void changeLedState(char);
void wait(volatile int);

int debounce = 50; //50 ms to debounce

//where PC0 = A/LED1, PC1 = B/LED2, PC2 = C/LED3, PC3 = D/LED4, PC4 = E/LED5, PC5 = F/LED6
int states_long = 6; // number of states of the LED pattern including 2nd state
char pattern_long[]={'A','B','C','D','E','F'};

int states_short = 3;
char pattern_short[]={'D','E','F'};

int main(void)
{
		
	// array contains the states of the LEDs in on-off pattern
	
		DDRD = 0b00000000; // all pins are inputs, PD2 & PD3 attached to switch
		DDRC = 0b00111111; // pins PC0-5 are outputs for LEDs for PortC
		DDRB = 0b00000011; // pins PB0 and PB1 are outputs for LEDs for PortB (switches)
		
		PORTC = 0b00111111; // turns off all LEDs PortC
		PORTB = 0b00000011; // turns off all LEDs for PortB these are outputs for switches
		
		// Set up Interrupts
		EICRA = 1<<ISC01 | 1<<ISC00 | 1<<ISC11 | 1<<ISC10;	// Trigger INT0 and INT1 on rising edge
		EIMSK = 1<<INT1 | 1<<INT0;	// Enable INT1 and INT0
		sei();	//Enable Global Interrupt
    
    while (1) 
    {
		// repeatedly displays LED patterns
		for(int i = 0; i < states_long; i++)// goes through LED pattern states
		{
			changeLedState(pattern_long[i]); // changes to a new state by passing current to function
		}
	}
	
	return(0);

}

//Interrupt INT0
//if switch 0 (top switch) pressed AND LED 3/PC2 is on, turn on LED 7/PB0 on and scroll short pattern
//main: loop forever
//ISR: turn on LED, scroll
//Triggered Externally
ISR(INT0_vect){
	if(PORTC == 0b00111011 ) { //switch 0 (PD2) is pressed (0) and PC2 = 0
		
		PORTB = PORTB & 0b00000010; // Turn on LED (0) by clearing PB0 (which is active low),  leave other bits unchanged  (AND PORTC with a binary number that has 0 in the only bit that we want to ensure is 0)
		
		sei(); //enables INT1 interrupt
		
		while (PORTB == 0b00000010) 
		{
			// repeatedly displays LED patterns
			for(int i = 0; i < states_short; i++)// goes through LED pattern states
			{
				changeLedState(pattern_short[i]); // changes to a new state by passing current to function
			}
		}
	}
	
	//PORTC = 0b;
	wait(50); // debounce the switch
	EIFR = 0b00000001;  // Clear the INT0 interrupt flag in case it was reset while in the ISR (so that it doesn't run again) but ignore the INT1 flag in case it was set while in this ISR
}

//Interrupt INT1
//if switch 1 pressed and LED 6/PC5 is on, turn on LED 8/PB1 for 3 seconds and resume original scrolling pattern (long) IN MAIN CODE
//main: loop forever
//ISR: turn on LED
ISR(INT1_vect){
	
	if(( PORTB == 0b00000010 && PORTC == 0b00011111 )) { //switch 1 (PD3) is pressed (0) and PC5 = 0
	
		PORTC = 0b00111111; //turn off all LEDs	
		PORTB = PORTB & 0b00000001; // Turn on LED (0) by clearing PB1 (which is active low),  leave other bits unchanged  
		
		
		wait(3000);
		
		PORTB = PORTB & 0b00000011; //turn off portb LEDs
		
		main();
		wait(50); // debounce the switch
		EIFR = 0b00000010;  // Clear the INT0 interrupt flag in case it was reset while in the ISR (so that it doesn't run again) but ignore the INT1 flag in case it was set while in this ISR
	}
	
	
}

void changeLedState(char newState)
{
	// this functions changes the LED states into a new state defined by the passed argument
	// works for both long and short patterns
	
	switch(newState)
	{
		case 'A': // PC0 is on (0), all other LEDs are off (1)
		PORTC=0b00111110; 
		wait(400);
		break;
		
		case 'B': // PC1 is on (0), all other LEDs are off (1)
		PORTC=0b00111101;
		wait(400);
		break;
		
		case 'C':// PC2 is on (0), all other LEDs are off (1)
		PORTC=0b00111011;
		wait(400);
		break;
		
		case 'D':// PC3 is on (0), all other LEDs are off (1)
		PORTC=0b00110111;
		wait(400);
		break;
		
		case 'E':// PC4 is on (0), all other LEDs are off (1)
		PORTC=0b00101111;
		wait(400);
		break;
		
		case 'F':// PC5 is on (0), all other LEDs are off (1)
		PORTC=0b00011111;
		wait(400);
		break;
		
		default: // Repeat immediately
		PORTC = 0b00111111; //all LEDs are off (0)
		
	}// end switch
} // end LED state change

void wait(volatile int multiple)
{
	// creates a delay equal to multiple T w/ T= 1ms
	// have to assume 16MHz clock
	
	while(multiple>0)
	{
		TCCR0A = 0x00; // clears WGM00 and WGM01 to ensure counter in normal mode
		TCNT0 = 0;// preload value for testing on count =250
		TCCR0B =  0b00000011;
		
		while(TCNT0<250)// exits when count - 250
		{
			
		}
		
		TCCR0B = 0x00; //stops TIMER0
		multiple--;
	}
}// end wait
