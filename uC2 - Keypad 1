unsigned char temp = 0;

int main(void)
{
	DDRD = 0b01000000;
	PORTD = 0b01000000;
	
	/* The following set columns as inputs */
	DDRC &= 0b00000001;	//&= set pin5(PC0) to input mode //COLUMN 1, BLUE WIRE, PC0
	DDRC &= 0b00000010;		//&= set pin6(PC1) to input mode //COLUMN 2, PURPLE WIRE, PC1
	DDRC &= 0b00000100;		//&= set pin7(PC2) to input mode //COLUMN 3, BLACK WIRE, PC2
	
	/* The following set rows as outputs */
	DDRD |= 0b10000000;		//|= set pin1(PD7) to output mode //ROW 1, RED WIRE, PD7
	DDRC |= 0b00001000;		//|= set pin2(PC3) to output mode //ROW 2, ORANGE WIRE, PC3
	DDRC |= 0b00010000;		//|= set pin3(PC4) to output mode //ROW 3, YELLOW WIRE, PC4
	DDRB |= 0b00100000;		//|= set pin4(PC5) to output mode //ROW 4, GREEN WIRE, PC5
	
	/* The following enable the pull-up resistors */
	PORTC |= 0b00000001;	// Enable Internal Pull-Up at PD2   SHOULD BE PC0
	PORTC |= 0b00000010;	// Enable Internal Pull-Up at PD3	SHOULD BE PC2
	PORTC |= 0b00000100;	// Enable Internal Pull-Up at PD4	SHOULD BE PC4
	
	
	
//SARTinit();			// Initialize the USART
	
	while (1)
	{
		PORTD = 0b00000000;

		PORTD = 0b01111111;	//Set R1 to LOW - scan row 1
		PORTC = 0b11111111;	//De-active all other bits
		
		//goal is three
		//if ((PIND & (1<<2)) == 0)
		if (PIND == 0b01111111) //scan row 1 red wire, PD7
		{
			_delay_ms(100);
			if (PINC == 0b11111011)//scan column 3 black wire pc2
			{
		//USARTsend ('3');	//Transmit ‘3’ 
		//temp = 3;
				//PD6 on
				PORTD = 0b00000000;
			}
		}
	}
	return 0;
}

