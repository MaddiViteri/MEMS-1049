void wait (volatile int multiple)
//creates delay equal to multiplier t
//assumes a 16Hrz clock frequency - change counts for different clocks 
	while(multiple > 0)
	{
		TCCR0A = 0x00; // clears WGM00 and WGM01 to ensure timer/counter is normal
		{
		
		TCNT0 = 0; //preload vlalue for testing on count = 250
		TCCR0B = 0b00000011; //start timer, norml mode, crystal clock, prescaler 64
		
		while (TCNT0 < 0xFA); //exits when count == 250
		
		TCCR0B = 0x00; //stop TIMER0
		multiple--;
	}
	
} //end wait
