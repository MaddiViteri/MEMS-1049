void change_led_state(char new)
//this function changes the LED states to a new state defined by the passed argument
{
	switch(new){
		case 'A' :
			PORTC = 0b00000000;
			wait(200);
			break;
		case'B':
			PORTC = 0b00000000;
			wait(600);
			break;
		case'C':
			PORTC = 0b00000011;
			wait(200)
			break;
		case 'D':
			PORTC = 0b00000011;
			wait(600)
			break;
		default:
			PORTC = 0b00000011;
			wait(2000);
			
