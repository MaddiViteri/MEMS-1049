#include <avr/io.h>
#define F_CPU 16000000UL  // 16 MHz
#include <util/delay.h>
#include "hd44780.h"

/*Global Variables*/
char temp = 'h';

/*Headers*/
void scan_Row(char row);
void scan_Row_One();
void scan_Row_Two();
void scan_Row_Three();
void scan_Row_Four();
void scan_Keypad();


/*Main Program Loop*/
int main(void)
{
	/* Set all PORTC pins as inputs with pull-ups enabled */
	DDRC = 0b00000000;  // All pins of PORTC are inputs
	PORTC = 0b11111111; // Enable pull-ups on PORTC

	/* Set PD7 (Row 1 - Red Wire) as an output */ //MOVED TO PB2
	//DDRD |= 0b10000000; // PD7 as output
	//PORTD |= 0b10000000; // Initially high
	
	/*Set PC3 (Row 2 - Orange Wire) as an output)*/
	DDRC |= 0b00001000; //Set PC3 as output
	PORTC |= 0b00001000; //Initially high
	
	/*Set PC4 (Row 3 - Yellow Wire) as an output)*/
	DDRC |= 0b00010000; // Set PC4 as output
	PORTC |= 0b00010000; //Initially high
	
	/*Set PC5 (Row 4 - Green Wire) as an output)*/
	DDRC |= 0b00100000; // Set PC5 as output
	PORTC |= 0b00100000; //Initially high

	/*Set up LED*/
	DDRB = 0b00000110; // LED pin to output PB2 to output
	PORTB = 0b00000110; //initially high and LED initially off

	// initialize display in 4 bit mode
	 HD44780_Init();

	 HD44780_DisplayClear(); // clear display

	 HD44780_PositionXY(0, 0); // set starting position
	 
	 HD44780_CursorBlink (); // blink cursor 

	while (1)
	{
		scan_Keypad();
		HD44780_DrawChar(temp);
		
	}

	return 0;
} //end main

/*Functions*/

void scan_Row(char row)
//this function scans the specified row and stores the detected number in a temp variable
{
	
	volatile char button_Array [3] = {'0','0','0'};
		 //initialize array to store numbers of current row of buttons
	
	switch (row)
	{
		case 1:
		//button_Array = {'1','2','3'}; //row 1
			button_Array [0] = '1';
			button_Array [1] = '2';
			button_Array [2] = '3';
		break;
		case 2:
		//button_Array = {'4','5','6'}; //row 2
			button_Array [0] = '4';
			button_Array [1] = '5';
			button_Array [2] = '6';
		break;
		case 3:
		//button_Array = {'7','8','9'}; //row 3
			button_Array [0] = '7';
			button_Array [1] = '8';
			button_Array [2] = '9';
		break;
		case 4:
		//button_Array = {'*','0','#'}; //row 4
			button_Array [0] = '*';
			button_Array [1] = '0';
			button_Array [2] = '#';
		break;
		default:
			button_Array [0] = 'a';
			button_Array [1] = 'b';
			button_Array [2] = 'c';
		break;
	} // end switch case
	
	
	
	//_delay_ms(10); // Delay for debouncing/stabilization
	
	/* Check if any button in row 1 is pressed */
	// Check if button in column 1 (PC0) is pressed
	if (!(PINC & 0b00000001))
	{
		_delay_ms(10); // Software debounce
		// Do something specific for button in row 1, column 1
		PORTB = 0b00000000;
		temp = button_Array[0];
		_delay_ms(10);
		PORTB = 0b00000010;
		//pressed=true
		
	}
	// Check if button in column 2 (PC1) is pressed
	else if (!(PINC & 0b00000010))
	{
		_delay_ms(10); // Software debounce
		// Do something specific for button in row 1, column 2
		PORTB = 0b00000000;
		temp = button_Array[1];
		_delay_ms(10);
		PORTB = 0b00000010;
	}
	// Check if button in column 3 (PC2) is pressed
	else if (!(PINC & 0b00000100))
	{
		_delay_ms(10); // Software debounce
		// Do something specific for button in row 1, column 3
		PORTB = 0b00000000;
		temp =button_Array[2];
		_delay_ms(10);
		PORTB = 0b00000010;
	}
} //end scan_Row

void scan_Row_One()
//this function scans row one to detect a key press in any column
{
	/* Drive PD7 (row 1) low */
	PORTB &= 0b11111011; // Set PD7 to low
	
	scan_Row(1);

	/* Reset row 1 to high */
	PORTB |= 0b00000100; // Set PD7 back to high
	
	_delay_ms(10); // Delay before the next scan to reduce bouncing/effects
}// end scan_Row_One

void scan_Row_Two()
//this function scans row two to detect a key press in any column
{
	/* Drive PC3 (row 2) low */
	PORTC &= 0b11110111; // Set PC3 to low
	
	scan_Row(2);

	/* Reset row 2 to high */
	PORTC |= 0b00001000; // Set PC3 back to high
	
	_delay_ms(10); // Delay before the next scan to reduce bouncing/effects
}// end scan_Row_Two

void scan_Row_Three()
//this function scans row two to detect a key press in any column
{
	/* Drive PC4 (row 3) low */
	PORTC &= 0b11101111; // Set PC4 to low
	
	scan_Row(3);

	/* Reset row 3 to high */
	PORTC |= 0b00010000; // Set PC4 back to high
	
	_delay_ms(10); // Delay before the next scan to reduce bouncing/effects
}// end scan_Row_Three

void scan_Row_Four()
//this function scans row two to detect a key press in any column
{
	/* Drive PC5 (row 4) low */
	PORTC &= 0b11011111; // Set PC5 to low
	
	scan_Row(4);

	/* Reset row 4 to high */
	PORTC |= 0b00100000; // Set PC5 back to high
	
	_delay_ms(10); // Delay before the next scan to reduce bouncing/effects
}// end scan_Row_Four

void scan_Keypad()
//this function scans all rows and all columns of the keypad
{
	scan_Row_One();
	scan_Row_Two();
	scan_Row_Three();
	scan_Row_Four();
	
// 	if pressed:
// 		change disp
// 		pressed = false
	
} //end of scan_Keypad

