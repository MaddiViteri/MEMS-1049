		if(date_Index == 2){
			date_Index++;
		}
		
		if(date_Index % 5 == 0){
			date_Index = 0;
		}
		
		HD44780_DrawString(date);
		HD44780_PositionXY(0, 1); // set starting position
		
	}
	
} //end of scan_Keypad
