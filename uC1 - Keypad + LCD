//LCD Screen
#include "hd44780.h"
/*Global Variables*/
char temp = 'h';
int is_Pressed = 0;
char date [6] = {'0','0', '/','0','0','\0'};
int date_Index = 0;
/*Headers*/
//Keypad
void scan_Row(char row);
void scan_Row_One();
void scan_Row_Two();
void scan_Row_Three();
